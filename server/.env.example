# Server
PORT=5000

# Leave MONGODB_URI empty to use the local file store (zero setup).
# For MongoDB Atlas use: mongodb+srv://user:pass@cluster.mongodb.net/yuvahive
MONGODB_URI=

# Used only when MONGODB_URI is empty. Relative to the server folder.
DATA_FILE=./data/quizzes.json

# Admin login for the dashboard
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@yuvahive.com
ADMIN_PASSWORD=YuvaHive@123

# Frontend origin allowed by CORS (comma separated for multiple)
CLIENT_ORIGIN=http://localhost:5173

# Scheduling
TIMEZONE=Asia/Kolkata
QUIZ_CRON=0 9 * * *
